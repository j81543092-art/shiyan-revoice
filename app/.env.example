# 拾言 ReVoice · 环境变量模板
#
# 用法：复制为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进仓库。
#   cp .env.example .env
#
# 不填任何值也能跑：适配层会自动降级到内置规则引擎，演示不中断。

# ── 模型侧（三选一，留空则用规则引擎）──────────────────────────

# 【推荐·赛题要求】华为云 MaaS / ModelArts Studio
# 认证方式是 Bearer API Key，不是 AK/SK 签名
MODEL_PROVIDER=huawei
HW_MAAS_API_KEY=
HW_MODEL_ENDPOINT=https://api.modelarts-maas.com/v2/chat/completions
HW_MODEL=DeepSeek-V3
HW_MAX_TOKENS=1024

# 【可选】任意 OpenAI 兼容接口（联调过渡用）
# MODEL_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# LLM_MODEL=gpt-4o-mini

# 【可选】零凭证兜底，全链路可跑通，评测数字的真实来源
# MODEL_PROVIDER=rule

# ── 语音侧（华为云 SIS 一句话识别）───────────────────────────
# 【患者的第一手线索来源】失语症患者说不出完整句子，只能蹦词。
# 这把「断断续续的话」变成线索碎片，交给意图理解。
#
# ⚠️ 认证方式与 LLM 不同：SIS 用 X-Auth-Token，而 Token 要用 IAM 凭证换取。
#    Token 有效期 24 小时，程序自动缓存与刷新。
#
# ⚠️ 区域限制：SIS 一句话识别**仅支持华北-北京四和华东-上海一**，
#    没有中国香港、没有西南-贵阳一。
HW_SIS_REGION=cn-north-4
# 可选：显式覆盖 endpoint（一般不用填，按区域自动推导）
# HW_SIS_ENDPOINT=https://sis-ext.cn-north-4.myhuaweicloud.com
# 模型特征串：语种_采样率_领域
HW_SIS_PROPERTY=chinese_16k_general
HW_SIS_ADD_PUNC=no

# IAM 凭证 —— 用于换取 SIS 所需的 Token
# 三选一路径：本版用「用户名+密码+账号名」，最易排障
HW_IAM_USERNAME=
HW_IAM_PASSWORD=
HW_IAM_DOMAIN=
# 项目 ID（SIS 的 URI 里要用）—— 控制台「我的凭证」页可查
HW_PROJECT_ID=
# 项目名（scope 用，与 projectId 二选一）
# HW_IAM_PROJECT=cn-north-4

# AK/SK —— 本版仅作为「是否已配置」的判断，不参与签名。
# 若后续要求纯 AK/SK 换 Token（安全审计要求不存密码），
# 需在 server/model/providers/iam.js 的 signRequestWithAkSk() 里补签名实现。
HW_AK=
HW_SK=

# ── 图片侧（华为云文生图，兜底用）────────────────────────────
# 【图标库为主，这里只做兜底】图标库秒级、离线、免费；
# 只有图标库覆盖不到的意图才调文生图（慢、按张计费）。
#
# ⚠️ 区域限制：文生图**仅支持西南-贵阳一**（与 LLM 所在区域不同是正常的）
HW_IMAGE_ENDPOINT=https://api.modelarts-maas.com/v1/images/generations
HW_IMAGE_MODEL=qwen-image
HW_IMAGE_SIZE=1024x1024
# 文生图较慢，超时给足；超时会静默回退到纯图标
HW_IMAGE_TIMEOUT_MS=45000

# ── 服务侧 ────────────────────────────────────────────────

# 部署平台会注入 PORT；华为云容器化部署同样读这个变量
PORT=3000
HOST=0.0.0.0

# ── 数据侧（云端替换为华为云 RDS + Redis）────────────────────

# 本地：SQLite 文件路径（默认 app/data/revoice.db）
# DB_PATH=./data/revoice.db

# 华为云 RDS（PostgreSQL 兼容）—— 表结构与 SQLite 版本对齐
# RDS_HOST=
# RDS_PORT=5432
# RDS_USER=
# RDS_PASSWORD=
# RDS_DATABASE=

# 华为云 DCS（Redis 兼容）—— 键语义与进程内 LRU 缓存一致
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
